#!/usr/bin/env bash
set -euo pipefail

BUN_VERSION="1.3.14"
ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
BUN_DIR="${ROOT_DIR}/.tools"
BUN_BIN="${BUN_DIR}/bun"

if [[ -x "${BUN_BIN}" ]]; then
  installed_version="$("${BUN_BIN}" --version 2>/dev/null || true)"
  if [[ "${installed_version}" == "${BUN_VERSION}" ]]; then
    exit 0
  fi
fi

mkdir -p "${BUN_DIR}"

OS="$(uname -s | tr '[:upper:]' '[:lower:]')"
ARCH="$(uname -m)"
case "${ARCH}" in
  x86_64) ARCH="x64" ;;
  aarch64|arm64) ARCH="arm64" ;;
  *) echo "ensure-bun: unsupported architecture: ${ARCH}" >&2; exit 1 ;;
esac

case "${OS}" in
  linux)
    if [[ -f /etc/alpine-release ]]; then
      ABI="-musl"
    elif command -v ldd >/dev/null 2>&1 && ldd --version 2>&1 | grep -qi musl; then
      ABI="-musl"
    else
      ABI=""
    fi
    ;;
  darwin) ABI="" ;;
  mingw*|cygwin*|msys*|windows*) OS="windows"; ABI="" ;;
  *) echo "ensure-bun: unsupported OS: ${OS}" >&2; exit 1 ;;
esac

URL="https://github.com/oven-sh/bun/releases/download/bun-v${BUN_VERSION}/bun-${OS}-${ARCH}${ABI}.zip"
TMP_DIR="$(mktemp -d)"
trap 'rm -rf "${TMP_DIR}"' EXIT

echo "ensure-bun: downloading bun v${BUN_VERSION} for ${OS}-${ARCH}${ABI:-}..." >&2

if command -v curl >/dev/null 2>&1; then
  curl -fsSL "${URL}" -o "${TMP_DIR}/bun.zip"
elif command -v wget >/dev/null 2>&1; then
  wget -q "${URL}" -O "${TMP_DIR}/bun.zip"
else
  echo "ensure-bun: curl or wget is required" >&2
  exit 1
fi

if command -v unzip >/dev/null 2>&1; then
  unzip -q "${TMP_DIR}/bun.zip" -d "${TMP_DIR}"
else
  echo "ensure-bun: unzip is required" >&2
  exit 1
fi

downloaded_bun="$(find "${TMP_DIR}" -type f -name bun | head -n 1)"
if [[ -z "${downloaded_bun}" ]]; then
  echo "ensure-bun: bun binary not found in downloaded archive" >&2
  exit 1
fi

mv "${downloaded_bun}" "${BUN_BIN}"
chmod +x "${BUN_BIN}"

"${BUN_BIN}" --version >/dev/null 2>&1 || { echo "ensure-bun: downloaded binary does not run" >&2; exit 1; }
echo "ensure-bun: bun v${BUN_VERSION} installed at ${BUN_BIN}" >&2
