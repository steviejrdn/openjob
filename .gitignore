# Dependencies
node_modules/
bun.lock

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# OpenJob runtime (dev launcher sandbox: auth, sessions, logs, tools)
/runtime/
/.runtime/
/.tools/

# Compiled documents
*.pdf
*.aux
*.log
*.out
*.synctex.gz
*.fls
*.fdb_latexmk

# Multi-user workspaces: each users/<name>/ directory holds personal data
# (profile, CV, documents, tracker, applications) plus generated framework
# links (fonts/, tools/, .agents/, salary_lookup.py). Never commit any of it.
users/

# Personal data that can land at the repo root
/AGENTS.md
salary_data.json
*_BehavioralReport.pdf
linkedin_Profile.pdf

# Secrets. A portal skill generated by /add-portal may need an API token for a
# fetching service; the .env holding it must never be committed.
.env
.env.*

# Personal photos and signatures
*.jpg
*.jpeg
*.png

# OS files
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/

# Skills lock (auto-generated)
skills-lock.json

# Agent skills: track the source, ignore only deps and logs.
# (A blanket `.agents/` ignore silently drops the job-search CLI skills from the repo.)
.agents/**/node_modules/
.agents/**/*.log
.agents/usage/

# Brainstorm mockups (superpowers visual companion) - never ship
.superpowers/
